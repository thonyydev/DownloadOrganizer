{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Download Organizer",
  "version": "../package.json",
  "identifier": "com.thonyy.download-organizer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Download Organizer",
        "width": 1240,
        "height": 840,
        "minWidth": 760,
        "minHeight": 580,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: data:; media-src 'self' media-preview: http://media-preview.localhost; connect-src ipc: http://ipc.localhost; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Thonyy",
    "homepage": "https://github.com/thonyydev/DownloadOrganizer",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "copyright": "Copyright (c) 2026 Thonyy",
    "shortDescription": "Organize your downloads safely, with a preview and undo",
    "windows": {
      "nsis": {
        "languages": ["English", "PortugueseBR", "Spanish", "French", "Italian"],
        "displayLanguageSelector": false,
        "installerHooks": "./nsis-hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEyQzIxRUVGNTQ5NEUzREUKUldUZTQ1UlU3eDdDRWowNkU1VFpxNGJ1VkJwdWZJQnJiVFcvOFBhUlB5UVFIR0hyRzM1VWdWVkMK",
      "endpoints": ["https://github.com/thonyydev/DownloadOrganizer/releases/latest/download/latest.json"]
    }
  }
}
